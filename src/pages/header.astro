---
const { currentPage } = Astro.props;
import TapeMachine from "../components/TapeMachine.astro";
import Van from "../components/Van.astro";
const { showTapeMachine, showVan } = Astro.props;
---

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>David Ross Audio</title>
    <link rel="icon" href="/images/png/DavidRossLogo.png" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

    <div class="wrap">
        <div class="nav">
            {showTapeMachine && <TapeMachine />}
            {showVan && <Van />}
            <nav class="nav-links">
                <a
                    class="hgreen"
                    id="wiggle"
                    href="/"
                    style={currentPage === "home" ? "color:var(--green)" : ""}
                    >/home</a
                >
                <a
                    class="horange"
                    id="wiggle"
                    href="/gear/"
                    style={currentPage === "gear" ? "color:var(--orange)" : ""}
                    >/kit list</a
                >
                <a
                    class="hblue"
                    id="wiggle"
                    href="/blog/"
                    style={currentPage === "blog" ? "color:var(--blue)" : ""}
                    >/blog</a
                >
                <a
                    class="hred"
                    id="wiggle"
                    href="/contact/"
                    style={currentPage === "contact" ? "color:var(--red)" : ""}
                    >/contact</a
                >
            </nav>
        </div>
    </div>
</head>
