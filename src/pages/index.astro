---
// import "../../public/style.css";

import Header from "./header.astro";
import Footer from "./footer.astro";
import PastWork from "./sub-pages/past-work.astro";
import AboutMe from "./sub-pages/about-me.astro";
import Layout from "../layouts/Layout.astro";
import RightColumn from "./right-column.astro";
---

<Layout title="Home">
    <!-- <link rel="stylesheet" href="style.css" /> -->
    <body>
        <Header currentPage="home" showVan={true} />
        <div class="scroll-container">
            <div class="column left-column">
                <AboutMe />
                <PastWork />
                <Footer />
            </div>
            <div class="column right-column">
                <RightColumn currentPage="home" />
            </div>
        </div>
    </body>
</Layout>
